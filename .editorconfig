root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,yml,yaml,json}]
indent_size = 2

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.cs]
# Roslyn rule tuning
dotnet_diagnostic.CA1303.severity = none      # Do not pass literals as localized parameters
dotnet_diagnostic.CA2007.severity = none      # ConfigureAwait — not relevant for console host
dotnet_diagnostic.CA1031.severity = none      # broad catch is intentional in retry loops
dotnet_diagnostic.CA1812.severity = none      # internal types are instantiated via DI
dotnet_diagnostic.CA1848.severity = none      # LoggerMessage source-gen — overkill for Phase 1
dotnet_diagnostic.CA1305.severity = none      # IFormatProvider — console output is en-US
dotnet_diagnostic.CA1860.severity = suggestion

# style
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:suggestion
dotnet_sort_system_directives_first = true
