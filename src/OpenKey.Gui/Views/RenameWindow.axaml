<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenKey.Gui.Views.RenameWindow"
        Width="400" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceOverlay}"
        Title="Rename chat">

  <Border Padding="24" BoxShadow="{DynamicResource ShadowOverlay}">
    <StackPanel Spacing="14">
      <TextBlock Name="HeadingText" Text="Rename this chat" FontSize="17" FontWeight="SemiBold" LineHeight="24"
                 Foreground="{DynamicResource Body}" />
      <TextBox Name="TitleBox" MaxLength="48" PlaceholderText="Chat name" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
        <Button Classes="ghost" Content="Cancel" Click="OnCancel" IsCancel="True" />
        <Button Name="ConfirmButton" Classes="primary" Content="Rename" Click="OnRename" IsDefault="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
