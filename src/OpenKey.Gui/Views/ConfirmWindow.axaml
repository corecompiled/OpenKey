<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenKey.Gui.Views.ConfirmWindow"
        Width="440" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceOverlay}"
        Title="OpenKey">

  <Border Padding="24" BoxShadow="{DynamicResource ShadowOverlay}">
    <StackPanel Spacing="16">
      <TextBlock Name="TitleText" FontSize="17" FontWeight="SemiBold" LineHeight="24"
                 Foreground="{DynamicResource Body}" TextWrapping="Wrap" />
      <TextBlock Name="BodyText" TextWrapping="Wrap" FontSize="13" LineHeight="20"
                 Foreground="{DynamicResource Muted}" />

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
        <!-- Cancel is default AND cancel: Escape must close a destructive dialog, and a stray
             Enter must never confirm one. -->
        <Button Name="CancelButton" Classes="ghost" Content="Cancel" Click="OnCancel"
                IsDefault="True" IsCancel="True" />
        <Button Name="ConfirmButton" Click="OnConfirm" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
