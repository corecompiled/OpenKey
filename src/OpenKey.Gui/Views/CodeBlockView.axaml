<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenKey.Gui.ViewModels"
             x:Class="OpenKey.Gui.Views.CodeBlockView"
             x:DataType="vm:MarkdownBlock">

  <!-- LineStrong, not Line: a fence is an object, and the hairline used for dividers is too
       faint to give it an edge — in mono it left the snippet floating on the page. -->
  <Border Background="{DynamicResource CodeSurface}"
          BorderBrush="{DynamicResource LineStrong}"
          BorderThickness="1" CornerRadius="6">
    <Grid RowDefinitions="Auto,*">

      <!-- Language label and copy button share a row so the button never overlaps code. -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="12,7,7,0">
        <TextBlock Grid.Column="0" Name="LanguageLabel"
                   FontSize="11" VerticalAlignment="Center"
                   Foreground="{DynamicResource Muted}" />
        <!-- MinWidth pins the width across the Copy/Copied swap, so the header does not jump at
             the moment you press it. Height comes from the shared button chassis: this used to be
             26px while the identical Copy on a reply was 34, so the two disagreed. -->
        <Button Grid.Column="1" Name="CopyButton" Classes="ghost" Click="OnCopy"
                Padding="10,5" FontSize="11" MinWidth="62"
                Content="Copy"
                ToolTip.Tip="Copy this code block" />
      </Grid>

      <!-- Selectable so a mouse drag works even without the button. -->
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    Padding="12,4,12,10">
        <SelectableTextBlock Name="CodeText"
                             FontFamily="Cascadia Mono,Consolas,Courier New,monospace"
                             FontSize="13"
                             TextWrapping="NoWrap"
                             Foreground="{DynamicResource CodeText}" />
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
